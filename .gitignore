.DS_Store
Thumbs.db
desktop.ini

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Android signing — never commit keystores or their passwords
*.keystore
*.jks
keystore.properties

# Test output
/TestResults/
*.xml.meta
